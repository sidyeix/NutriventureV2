    ingredientIcon: {fileID: 21300000, guid: c0a6a8a62de941b48a9bbb92fbfd9f28, type: 3}
    silhouetteIndex: -1
  - ingredientId: fish
    ingredientName: Fish
    ingredientDescription: A common allergen that can cause severe reactions in sensitive
      individuals. Contains specific proteins that may trigger allergic responses
      even in small amounts.
    ingredientIcon: {fileID: 21300000, guid: eed61c787378b7643b7a9c0d2bc3b0fe, type: 3}
    silhouetteIndex: -1
  - ingredientId: shellfish
    ingredientName: Shellfish
    ingredientDescription: A common allergen that can cause severe reactions in sensitive
      individuals. Includes crustaceans like shrimp, crab, and lobster which can
      cause particularly strong reactions.
    ingredientIcon: {fileID: 21300000, guid: fdf5907be4dad0943b8e706751942321, type: 3}
    silhouetteIndex: -1
  - ingredientId: tree nuts
    ingredientName: Tree Nuts
    ingredientDescription: A common allergen that can cause severe reactions in sensitive
      individuals. Includes almonds, walnuts, cashews, and other tree-grown nuts
      with potent allergenic proteins.
    ingredientIcon: {fileID: 21300000, guid: 96fd00010fd939b4ea0c699940240450, type: 3}
    silhouetteIndex: -1
  - ingredientId: wheat
    ingredientName: Wheat
    ingredientDescription: A common allergen that can cause severe reactions in sensitive
      individuals. Contains gluten and other proteins that may trigger celiac disease
      or wheat allergies.
    ingredientIcon: {fileID: 21300000, guid: 6eb742647711c3548b90c07e6728be35, type: 3}
    silhouetteIndex: -1
  - ingredientId: soybeans
    ingredientName: Soybeans
    ingredientDescription: A common allergen that can cause severe reactions in sensitive
      individuals. Legume-based ingredient with proteins that may trigger immune
      responses.
    ingredientIcon: {fileID: 21300000, guid: ed6d4643205cfd043b5b2440edc0356d, type: 3}
    silhouetteIndex: -1
  - ingredientId: sesame
